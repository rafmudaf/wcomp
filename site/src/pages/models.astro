---
import Layout from '../layouts/Layout.astro';
import { getModels } from '../lib/dataset.js';

const models = getModels();
const softwareNames = ['FLORIS', 'FOXES', 'PyWake'];
const categories = [
  { key: 'velocity', label: 'Velocity models' },
  { key: 'deflection', label: 'Deflection models' },
];
const base = import.meta.env.BASE_URL;
---
<Layout title="Implementation matrix">
  <h1>Implementation matrix</h1>
  <p>
    Which software implements which wake model. Models with a linked name have a full
    comparison page (charts + quantitative metrics) generated from the dataset.
  </p>
  {categories.map(({ key, label }) => (
    <section>
      <h2>{label}</h2>
      <table>
        <thead>
          <tr>
            <th>Wake model</th>
            {softwareNames.map((s) => <th class="check-cell">{s}</th>)}
          </tr>
        </thead>
        <tbody>
          {models.filter((m) => m.category === key).map((m) => (
            <tr>
              <td>
                {m.case ? (
                  <a href={`${base}compare/four_turbine__${m.case}/`}>{m.name}</a>
                ) : m.name}
              </td>
              {softwareNames.map((s) => (
                <td class="check-cell">{m.software.includes(s) && <span class="check">&check;</span>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</Layout>
