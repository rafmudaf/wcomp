---
import Layout from '../layouts/Layout.astro';
import { getAllCases, getManifest, getModels } from '../lib/dataset.js';

const manifest = getManifest();
const cases = getAllCases();
const models = getModels();
const base = import.meta.env.BASE_URL;

const byScenario = new Map();
for (const c of cases) {
  const list = byScenario.get(c.scenario) ?? [];
  list.push(c);
  byScenario.set(c.scenario, list);
}
const scenarioLabels = {
  one_turbine: 'One turbine',
  four_turbine: 'Four turbines',
};

const softwareNames = ['FLORIS', 'FOXES', 'PyWake'];
const modelCategories = [
  { key: 'velocity', label: 'Velocity models' },
  { key: 'deflection', label: 'Deflection models' },
];
---
<Layout title="WComp - Wake model implementations compared">
  <h1>Wake model comparisons</h1>
  <p>
    wcomp runs the same windIO wind-farm cases through FLORIS, FOXES, and PyWake
    so the same wake model can be compared directly across independent implementations. Every
    chart on this site reads from a versioned dataset generated with wcomp's solver interfaces.
  </p>
  <p>
    Generated {new Date(manifest.generated_at).toLocaleDateString()} against FLORIS{' '}
    {manifest.software_versions.FLORIS}, FOXES {manifest.software_versions.FOXES}, and PyWake
    {manifest.software_versions.PyWake}.
  </p>
  <h2>Framework details</h2>
  <div class="case-grid">
    <a class="case-card" href={`${base}compare/rotor-averaging/`}>
      <strong>Rotor velocity averaging</strong>
      <div><span class="tag">numerics</span></div>
      <div>FLORIS, FOXES, PyWake</div>
    </a>
  </div>

  <h2>Case comparisons</h2>
  {[...byScenario.entries()].map(([scenario, scenarioCases]) => (
    <section>
      <h3>{scenarioLabels[scenario] ?? scenario}</h3>
      <div class="case-grid">
        {scenarioCases.map((c) => (
          <a class="case-card" href={`${base}compare/${c.id}/`}>
            <strong>{c.wake_model}</strong>
            <div>{c.categories.map((category) => <span class="tag">{category}</span>)}</div>
            <div>{c.software.join(', ')}</div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <h2>Implementation matrix</h2>
  <p>
    Which software implements which wake model. Models with a linked name have a full
    comparison page (charts + quantitative metrics) generated from the dataset.
  </p>
  {modelCategories.map(({ key, label }) => (
    <section>
      <h3>{label}</h3>
      <table>
        <thead>
          <tr>
            <th>Wake model</th>
            {softwareNames.map((s) => <th class="check-cell">{s}</th>)}
          </tr>
        </thead>
        <tbody>
          {models.filter((m) => m.category === key).map((m) => (
            <tr>
              <td>
                {m.case ? (
                  <a href={`${base}compare/four_turbine__${m.case}/`}>{m.name}</a>
                ) : m.name}
              </td>
              {softwareNames.map((s) => (
                <td class="check-cell">{m.software.includes(s) && <span class="check">&check;</span>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</Layout>
