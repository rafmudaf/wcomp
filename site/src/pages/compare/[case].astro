---
import CasePage from '../../components/CasePage.astro';
import { getAllCases } from '../../lib/dataset.js';

export function getStaticPaths() {
  return getAllCases('default').map((c) => ({ params: { case: c.id }, props: { caseData: c } }));
}

const { caseData } = Astro.props;
---
<CasePage alignment="default" caseData={caseData} />
