---
import Layout from '../../layouts/Layout.astro';
import { getAllCases } from '../../lib/dataset.js';

export function getStaticPaths() {
  return getAllCases().map((c) => ({ params: { case: c.id }, props: { caseData: c } }));
}

const { caseData } = Astro.props;
const base = import.meta.env.BASE_URL;
const dataBase = `${base}dataset/cases/${caseData.id}`;
const otherScenario = caseData.scenario === 'four_turbine' ? 'one_turbine' : 'four_turbine';
const siblingId = `${otherScenario}__${caseData.wake_model}`;
const scenarioLabels = { one_turbine: 'one turbine', four_turbine: 'four turbines' };
---
<Layout title={`${caseData.wake_model} (${caseData.scenario})`}>
  <p><a href={base}>&larr; All comparisons</a></p>
  <h1>{caseData.wake_model} <small>&mdash; {scenarioLabels[caseData.scenario]}</small></h1>
  <p>
    {caseData.categories.map((category) => <span class="tag">{category}</span>)}
    Software: {caseData.software.join(', ')} &middot;
    Rotor diameter {caseData.rotor_diameter} m &middot;
    Wind speed {caseData.wind_speed} m/s
  </p>
  <p>
    <a href={`${base}compare/${siblingId}/`}>
      View the {scenarioLabels[otherScenario]} scenario for this wake model &rarr;
    </a>
  </p>

  <section>
    <h2>Layout &amp; sample locations</h2>
    <p>Turbine positions (bold, rotated by yaw angle where applicable) and the cross-section sample planes (dashed) used by the plots below.</p>
    <div id="layout-diagram"></div>
  </section>

  <section>
    <h2>Streamwise velocity</h2>
    <div id="chart-streamwise" class="chart"></div>
  </section>

  <section>
    <h2>Cross-sections</h2>
    {caseData.xsection_labels.map((label) => (
      <div id={`chart-xsection-${label}`} class="chart" data-label={label} />
    ))}
  </section>

  {caseData.has_contour && (
    <section>
      <h2>Horizontal contour</h2>
      <p>X-Y plane at hub height.</p>
      <div id="chart-contour" class="chart"></div>
    </section>
  )}

  {caseData.has_contour && (
    <section>
      <h2>Vertical contour</h2>
      <p>X-Z plane at Y=0 (lateral centerline).</p>
      <div id="chart-contour-vertical" class="chart"></div>
    </section>
  )}

  {caseData.has_contour && (
    <section>
      <h2>Cross-section contour</h2>
      <p>Y-Z plane at X={caseData.xsection_contour_location_d}D.</p>
      <div id="chart-contour-xsection" class="chart"></div>
    </section>
  )}

  <section>
    <h2>Comparison metrics</h2>
    <p>Pairwise error between software for each plotted quantity. Click a column to sort.</p>
    <table id="metrics-table">
      <thead>
        <tr>
          <th class="sortable" data-key="pair">Software pair</th>
          <th class="sortable" data-key="target">Target</th>
          <th class="sortable" data-key="rmse">RMSE (m/s)</th>
          <th class="sortable" data-key="max_abs">Max abs error (m/s)</th>
          <th class="sortable" data-key="mean_abs">Mean abs error (m/s)</th>
          <th class="sortable" data-key="nrmse">NRMSE</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </section>

  <script
    define:vars={{
      dataBase,
      software: caseData.software,
      xsectionLabels: caseData.xsection_labels,
      hasContour: caseData.has_contour,
      windSpeed: caseData.wind_speed,
      rotorDiameter: caseData.rotor_diameter,
      turbineLocationsD: caseData.turbine_locations_d,
      turbineYawDeg: caseData.turbine_yaw_deg,
      xsectionLocationsD: caseData.xsection_locations_d,
    }}
  >
    const COLORS = { FLORIS: '#2ca02c', FOXES: '#d62728', PyWake: '#1f77b4' };

    async function fetchJson(path) {
      const res = await fetch(path);
      if (!res.ok) throw new Error(`Failed to fetch ${path}: ${res.status}`);
      return res.json();
    }

    async function loadPerSoftware(pathSuffix) {
      const entries = await Promise.all(
        software.map(async (name) => {
          try {
            return [name, await fetchJson(`${dataBase}/software/${name}/${pathSuffix}`)];
          } catch {
            return [name, null];
          }
        })
      );
      return Object.fromEntries(entries);
    }

    function plotProfiles(divId, profiles, xlabel, ylabel) {
      const traces = software
        .filter((name) => profiles[name])
        .map((name) => ({
          x: profiles[name].x1,
          y: profiles[name].values,
          mode: 'lines',
          name,
          line: { color: COLORS[name], width: 2 },
        }));
      Plotly.newPlot(
        divId,
        traces,
        {
          template: 'plotly_white',
          xaxis: { title: xlabel },
          // Pin the velocity axis to [0, ambient wind speed] so every panel/case is
          // visually comparable rather than autoscaled to each trace's own range.
          yaxis: { title: ylabel, range: [0, windSpeed] },
          margin: { t: 20, b: 40, l: 55, r: 20 },
          height: 340,
          legend: { orientation: 'h' },
        },
        { responsive: true }
      );
    }

    async function renderCharts() {
      const streamwise = await loadPerSoftware('streamwise.json');
      plotProfiles('chart-streamwise', streamwise, 'X (m)', 'U (m/s)');

      for (const label of xsectionLabels) {
        const xsection = await loadPerSoftware(`xsections/${label}.json`);
        plotProfiles(`chart-xsection-${label}`, xsection, 'Y (m)', 'U (m/s)');
      }

      if (hasContour) {
        await renderContour('chart-contour', 'contour.json', 'X (m)', 'Y (m)');
        await renderContour('chart-contour-vertical', 'contour_vertical.json', 'X (m)', 'Z (m)');
        await renderContour('chart-contour-xsection', 'contour_xsection.json', 'Y (m)', 'Z (m)');
      }
    }

    async function renderContour(divId, pathSuffix, xlabel, ylabel) {
      const planes = await loadPerSoftware(pathSuffix);
      const present = software.filter((name) => planes[name]);
      if (present.length === 0) return;
      const traces = present.map((name, i) => {
        const plane = planes[name];
        const suffix = i === 0 ? '' : String(i + 1);
        return {
          type: 'scattergl',
          mode: 'markers',
          x: plane.x1,
          y: plane.x2,
          marker: {
            color: plane.values,
            colorscale: 'RdBu',
            reversescale: true,
            cmin: 0,
            cmax: windSpeed,
            size: 4,
            colorbar: i === present.length - 1 ? { title: 'm/s' } : undefined,
          },
          name,
          xaxis: `x${suffix}`,
          yaxis: `y${suffix}`,
        };
      });

      // The wake domain is far wider (streamwise) than it is tall (crosswind), so
      // stack one panel per software (rather than side-by-side) and size each row's
      // height from the data's real aspect ratio, then lock x/y to equal scale.
      const containerWidth = document.getElementById(divId).clientWidth || 1000;
      const aspect = Math.max(
        ...present.map((name) => {
          const plane = planes[name];
          const xRange = Math.max(...plane.x1) - Math.min(...plane.x1);
          const yRange = Math.max(...plane.x2) - Math.min(...plane.x2);
          return xRange / yRange;
        })
      );
      const rowHeight = Math.min(420, Math.max(140, containerWidth / aspect));

      const layout = {
        template: 'plotly_white',
        height: (rowHeight + 50) * present.length + 40,
        showlegend: false,
        margin: { t: 30, b: 40, l: 55, r: 20 },
        grid: { rows: present.length, columns: 1, pattern: 'independent', ygap: 0.25 },
        annotations: present.map((name, i) => ({
          text: name,
          showarrow: false,
          xref: `x${i === 0 ? '' : i + 1} domain`,
          yref: `y${i === 0 ? '' : i + 1} domain`,
          x: 0.5,
          y: 1.1,
        })),
      };
      present.forEach((name, i) => {
        const suffix = i === 0 ? '' : String(i + 1);
        layout[`xaxis${suffix}`] = { constrain: 'domain', title: xlabel };
        layout[`yaxis${suffix}`] = { scaleanchor: `x${suffix}`, scaleratio: 1, title: ylabel };
      });

      Plotly.newPlot(divId, traces, layout, { responsive: true });
    }

    function renderLayoutDiagram() {
      const container = document.getElementById('layout-diagram');
      const width = container.clientWidth || 900;
      const height = 190;
      const leftMargin = 50;
      const rightMargin = 30;
      const lastTurbineD = Math.max(...turbineLocationsD);
      const xmin = -1 * rotorDiameter;
      const xmax = (lastTurbineD + 20) * rotorDiameter;
      const scale = (width - leftMargin - rightMargin) / (xmax - xmin);
      const xPx = (distanceM) => leftMargin + (distanceM - xmin) * scale;

      // Top to bottom: plane labels, the planes themselves (centered on the axis),
      // turbines drawn on the axis, turbine labels, then the streamwise arrow. Each
      // marker type gets its own horizontal band so nearby labels never collide.
      const axisY = 78;
      const planeLabelY = 16;
      const planeTop = axisY - 42;
      const planeBottom = axisY + 42;
      const turbineTop = axisY - 16;
      const turbineBottom = axisY + 16;
      const turbineLabelY = planeBottom + 18;
      const arrowY = turbineLabelY + 24;
      const arrowLabelY = arrowY + 16;

      const planes = Object.entries(xsectionLocationsD)
        .map(([label, distanceD]) => {
          const x = xPx(distanceD * rotorDiameter);
          return `
            <line x1="${x.toFixed(1)}" y1="${planeTop}" x2="${x.toFixed(1)}" y2="${planeBottom}"
                  stroke="#2563eb" stroke-width="2.5" stroke-dasharray="6 5" />
            <text x="${x.toFixed(1)}" y="${planeLabelY}" text-anchor="middle" class="plane-label">${distanceD}D</text>
          `;
        })
        .join('');

      const turbines = turbineLocationsD
        .map((turbineD, i) => {
          const x = xPx(turbineD * rotorDiameter);
          const yaw = turbineYawDeg[i] ?? 0;
          const rotate = yaw ? ` transform="rotate(${yaw} ${x.toFixed(1)} ${axisY})"` : '';
          const label = `${turbineD}D` + (yaw ? ` (${yaw}\u00b0 yaw)` : '');
          return `
            <line x1="${x.toFixed(1)}" y1="${turbineTop}" x2="${x.toFixed(1)}" y2="${turbineBottom}"
                  stroke="#111827" stroke-width="6" stroke-linecap="round"${rotate} />
            <text x="${x.toFixed(1)}" y="${turbineLabelY}" text-anchor="middle" class="turbine-label">${label}</text>
          `;
        })
        .join('');

      const streamStart = xPx(xmin);
      const streamEnd = xPx(xmax);
      const streamMid = 0.5 * (streamStart + streamEnd);

      container.innerHTML = `
        <svg viewBox="0 0 ${width} ${height}" width="100%" role="img" aria-label="Turbine and sample-plane layout">
          <defs>
            <marker id="layout-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
              <path d="M 0 0 L 6 3 L 0 6 z" fill="#d97706" />
            </marker>
            <style>
              .plane-label { font-size: 12px; font-weight: 600; fill: #2563eb; }
              .turbine-label { font-size: 12px; font-weight: 600; fill: #111827; }
              .caption { font-size: 11px; fill: #6b7280; }
            </style>
          </defs>
          <rect x="0" y="0" width="${width}" height="${height}" rx="12" fill="#fafafa" stroke="#e5e7eb" />
          ${planes}
          <line x1="${leftMargin}" y1="${axisY}" x2="${width - rightMargin}" y2="${axisY}" stroke="#9ca3af" stroke-width="2" />
          ${turbines}
          <line x1="${streamStart.toFixed(1)}" y1="${arrowY}" x2="${streamEnd.toFixed(1)}" y2="${arrowY}"
                stroke="#d97706" stroke-width="1.5" marker-start="url(#layout-arrow)" marker-end="url(#layout-arrow)" />
          <text x="${streamMid.toFixed(1)}" y="${arrowLabelY}" text-anchor="middle" class="caption" fill="#d97706">Streamwise direction (X)</text>
        </svg>
      `;
    }

    function renderMetricsTable() {
      const tbody = document.querySelector('#metrics-table tbody');
      let sortKey = null;
      let sortAsc = true;
      let rows = [];

      function render() {
        tbody.innerHTML = '';
        for (const row of rows) {
          const tr = document.createElement('tr');
          for (const value of [row.pair, row.target, row.rmse, row.max_abs, row.mean_abs, row.nrmse]) {
            const td = document.createElement('td');
            td.textContent = typeof value === 'number' ? value.toFixed(4) : (value ?? '\u2014');
            tr.appendChild(td);
          }
          tbody.appendChild(tr);
        }
      }

      document.querySelectorAll('#metrics-table th.sortable').forEach((th) => {
        th.addEventListener('click', () => {
          const key = th.dataset.key;
          sortAsc = sortKey === key ? !sortAsc : true;
          sortKey = key;
          rows = [...rows].sort((a, b) => {
            const av = a[key];
            const bv = b[key];
            const cmp = typeof av === 'number' ? av - bv : String(av).localeCompare(String(bv));
            return sortAsc ? cmp : -cmp;
          });
          render();
        });
      });

      fetchJson(`${dataBase}/metrics.json`).then((metrics) => {
        rows = metrics.map((m) => ({ ...m, pair: m.pair.join(' vs ') }));
        render();
      });
    }

    renderLayoutDiagram();
    renderCharts();
    renderMetricsTable();
  </script>
</Layout>
