---
import AlignmentBanner from './AlignmentBanner.astro';
import Layout from '../layouts/Layout.astro';
import {
  getAllCases,
  getCaseMetrics,
  getManifest,
  getModels,
  getRotorAverageComparison,
  getTurbinePerformanceComparison,
  pageUrl,
} from '../lib/dataset.js';

interface Props {
  alignment: string;
}
const { alignment } = Astro.props;
const manifest = getManifest();
const cases = getAllCases(alignment);
const models = getModels();
const base = import.meta.env.BASE_URL;
const url = (pagePath = '') => pageUrl(base, alignment, pagePath);

const byScenario = new Map();
for (const c of cases) {
  const list = byScenario.get(c.scenario) ?? [];
  list.push(c);
  byScenario.set(c.scenario, list);
}
const scenarioLabels = {
  one_turbine: 'One turbine',
  four_turbine: 'Four turbines',
};

const softwareNames = ['FLORIS', 'FOXES', 'PyWake'];
const modelCategories = [
  { key: 'velocity', label: 'Velocity models' },
  { key: 'deflection', label: 'Deflection models' },
];

const modelLabels = {
  jensen: 'Jensen',
  jimenez: 'Jimenez',
  bastankhah2014: 'Bastankhah 2014',
  bastankhah2016: 'Bastankhah 2016',
  bastankhah2016_deflection: 'Bastankhah 2016 deflection',
  turbopark: 'TurbOPark',
};
const modelLabel = (c) => modelLabels[c.wake_model] ?? c.wake_model;
const pct = (value, digits = 1) => `${(value * 100).toFixed(digits)}%`;
const sci = (value) => value.toExponential(0);

// Framework TLDR: rotor-averaging case with the widest spread between software
// and turbine-curve agreement, both read from the dataset.
const rotor = getRotorAverageComparison(alignment);
const widestRotorCase = rotor.cases
  .map((item) => {
    const sorted = [...item.results].sort((a, b) => a.relative_error - b.relative_error);
    return { item, best: sorted[0], worst: sorted[sorted.length - 1] };
  })
  .sort((a, b) => (b.worst.relative_error - b.best.relative_error) - (a.worst.relative_error - a.best.relative_error))[0];

const turbine = getTurbinePerformanceComparison(alignment);
const maxOf = (key) => Math.max(...turbine.results.map((r) => r[key]));
const clippedCtSoftware = [...turbine.results].sort((a, b) => b.max_abs_ct_error - a.max_abs_ct_error)[0];

// Case TLDR: streamwise-profile RMSE for every software pair in every case.
const streamwiseRows = cases.flatMap((c) =>
  getCaseMetrics(alignment, c.id)
    .filter((m) => m.target === 'streamwise')
    .map((m) => ({ c, pair: m.pair.join(' vs '), rmse: m.rmse, nrmse: m.nrmse })),
);
const worstRow = [...streamwiseRows].sort((a, b) => b.nrmse - a.nrmse)[0];
const maxRmse = (scenario, model) => Math.max(
  ...streamwiseRows.filter((r) => r.c.scenario === scenario && r.c.wake_model === model).map((r) => r.rmse),
);
const growth = [...new Set(cases.map((c) => c.wake_model))]
  .filter((model) => model !== worstRow.c.wake_model)
  .map((model) => ({
    model,
    one: maxRmse('one_turbine', model),
    four: maxRmse('four_turbine', model),
  }))
  .sort((a, b) => (b.four - b.one) - (a.four - a.one))[0];
const growthOne = cases.find((c) => c.scenario === 'one_turbine' && c.wake_model === growth.model);
const growthFour = cases.find((c) => c.scenario === 'four_turbine' && c.wake_model === growth.model);
---
<Layout title="WComp - Wake model implementations compared" alignment={alignment}>
  <AlignmentBanner alignment={alignment} />
  <h1>Wake model comparisons</h1>
  <p>
    wcomp runs the same windIO wind-farm cases through FLORIS, FOXES, and PyWake
    so the same wake model can be compared directly across independent implementations. Every
    chart on this site reads from a versioned dataset generated with wcomp's solver interfaces.
  </p>
  <p>
    Generated {new Date(manifest.generated_at).toLocaleDateString()} against FLORIS{' '}
    {manifest.software_versions.FLORIS}, FOXES {manifest.software_versions.FOXES}, and PyWake
    {manifest.software_versions.PyWake}.
  </p>
  <h2>Framework details</h2>
  <ul class="tldr">
    <li>
      {alignment === 'default' ? 'Rotor averaging is the largest source of framework differences.' : 'With the rotor sampling matched, rotor averaging contributes little.'}
      {' '}On the{" "}<a href={url(`compare/rotor-averaging/#${widestRotorCase.item.key}`)}>{widestRotorCase.item.name.toLowerCase()}</a>{" "}field the rotor-average error ranges from {pct(widestRotorCase.best.relative_error)} ({widestRotorCase.best.software})
      to {pct(widestRotorCase.worst.relative_error)} ({widestRotorCase.worst.software}).
    </li>
    <li>
      Power and thrust tables are reproduced essentially exactly
      (power within {sci(maxOf('max_abs_power_error_in_range_kw'))} kW, Ct within {sci(maxOf('max_abs_ct_error_in_range'))} in range).
      The one visible difference is{" "}<a href={url('compare/turbine-performance/#thrust-coefficient')}>{clippedCtSoftware.software}'s Ct</a>,
      which is clipped by {sci(clippedCtSoftware.max_abs_ct_error)} outside the cut-in/cut-out range.
    </li>
  </ul>
  <div class="case-grid">
    <a class="case-card" href={url('compare/rotor-averaging/')}>
      <strong>Rotor velocity averaging</strong>
      <div><span class="tag">numerics</span></div>
      <div>FLORIS, FOXES, PyWake</div>
    </a>
    <a class="case-card" href={url('compare/turbine-performance/')}>
      <strong>Turbine power and thrust</strong>
      <div><span class="tag">turbine model</span></div>
      <div>FLORIS, FOXES, PyWake</div>
    </a>
  </div>

  <h2>Case comparisons</h2>
  <ul class="tldr">
    <li>
      The largest streamwise disagreement is{" "}<a href={url(`compare/${worstRow.c.id}/#streamwise`)}>{modelLabel(worstRow.c)} with {scenarioLabels[worstRow.c.scenario].toLowerCase()}</a>,{" "}{worstRow.pair}: {worstRow.rmse.toFixed(2)} m/s RMSE ({pct(worstRow.nrmse)} NRMSE).
    </li>
    <li>
      Differences grow with turbine count. {modelLabel(growthOne)} goes from{" "}<a href={url(`compare/${growthOne.id}/#streamwise`)}>{growth.one.toFixed(2)} m/s</a> RMSE (max over software pairs) with one turbine to{" "}<a href={url(`compare/${growthFour.id}/#streamwise`)}>{growth.four.toFixed(2)} m/s</a> with four.
    </li>
  </ul>
  {[...byScenario.entries()].map(([scenario, scenarioCases]) => (
    <section>
      <h3>{scenarioLabels[scenario] ?? scenario}</h3>
      <div class="case-grid">
        {scenarioCases.map((c) => (
          <a class="case-card" href={url(`compare/${c.id}/`)}>
            <strong>{c.wake_model}</strong>
            <div>{c.categories.map((category) => <span class="tag">{category}</span>)}</div>
            <div>{c.software.join(', ')}</div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <h2>Implementation matrix</h2>
  <p>
    Which software implements which wake model. Models with a linked name have a full
    comparison page (charts + quantitative metrics) generated from the dataset.
  </p>
  {modelCategories.map(({ key, label }) => (
    <section>
      <h3>{label}</h3>
      <table>
        <thead>
          <tr>
            <th>Wake model</th>
            {softwareNames.map((s) => <th class="check-cell">{s}</th>)}
          </tr>
        </thead>
        <tbody>
          {models.filter((m) => m.category === key).map((m) => (
            <tr>
              <td>
                {m.case ? (
                  <a href={url(`compare/four_turbine__${m.case}/`)}>{m.name}</a>
                ) : m.name}
              </td>
              {softwareNames.map((s) => (
                <td class="check-cell">{m.software.includes(s) && <span class="check">&check;</span>}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</Layout>

<style>
  .tldr {
    background: #f9fafb;
    margin: 1rem 0;
    padding: 0.6rem 1rem 0.6rem 2rem;
    font-size: 0.95rem;
  }
  .tldr li + li { margin-top: 0.4rem; }
</style>
