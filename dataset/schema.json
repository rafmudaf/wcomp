{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wcomp.dev/schemas/dataset.schema.json",
  "title": "wcomp comparison dataset",
  "description": "Document contracts for the JSON datasets generated by wcomp and consumed by its site.",
  "$defs": {
    "Manifest": {
      "type": "object",
      "required": ["generated_at", "wcomp_version", "software_versions", "cases"],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "wcomp_version": {"type": "string", "minLength": 1},
        "software_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "cases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "required": ["name", "category", "software", "case"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["velocity", "deflection"]},
        "software": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "case": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "ModelRegistry": {"type": "array", "items": {"$ref": "#/$defs/Model"}},
    "ModelConfigurationEntry": {
      "type": "object",
      "required": ["category", "name", "parameters"],
      "properties": {
        "category": {"type": "string", "enum": ["velocity", "deflection"]},
        "name": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      },
      "additionalProperties": false
    },
    "ImplementationConfiguration": {
      "type": "object",
      "required": ["software", "models", "notes"],
      "properties": {
        "software": {"type": "string", "minLength": 1},
        "models": {"type": "array", "items": {"$ref": "#/$defs/ModelConfigurationEntry"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "ModelConfiguration": {
      "type": "object",
      "required": ["inputs", "implementations", "notes"],
      "properties": {
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/ModelConfigurationEntry"}},
        "implementations": {"type": "array", "items": {"$ref": "#/$defs/ImplementationConfiguration"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "Case": {
      "type": "object",
      "required": ["scenario", "wake_model", "categories", "rotor_diameter", "hub_height", "wind_speed", "turbine_locations_d", "turbine_yaw_deg", "software", "model_configuration", "xsection_labels", "xsection_locations_d", "has_contour", "xsection_contour_location_d"],
      "properties": {
        "scenario": {"type": "string", "minLength": 1},
        "wake_model": {"type": "string", "minLength": 1},
        "categories": {"type": "array", "items": {"type": "string", "enum": ["velocity", "deflection"]}, "uniqueItems": true},
        "rotor_diameter": {"type": "number", "exclusiveMinimum": 0},
        "hub_height": {"type": "number", "exclusiveMinimum": 0},
        "wind_speed": {"type": "number", "minimum": 0},
        "turbine_locations_d": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "turbine_yaw_deg": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "software": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "model_configuration": {"$ref": "#/$defs/ModelConfiguration"},
        "xsection_labels": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "xsection_locations_d": {"type": "object", "additionalProperties": {"type": "number"}},
        "has_contour": {"type": "boolean"},
        "xsection_contour_location_d": {"type": "number"}
      },
      "additionalProperties": false
    },
    "WakeProfile": {
      "type": "object",
      "required": ["x1", "values"],
      "properties": {
        "x1": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "values": {"type": "array", "items": {"type": "number"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "WakePlane": {
      "type": "object",
      "required": ["x1", "x2", "values", "normal_vector"],
      "properties": {
        "x1": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "x2": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "values": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "normal_vector": {"type": "string", "enum": ["x", "y", "z"]}
      },
      "additionalProperties": false
    },
    "SoftwareMetadata": {
      "type": "object",
      "required": ["version"],
      "properties": {"version": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "Metric": {
      "type": "object",
      "required": ["pair", "target", "rmse", "max_abs", "mean_abs", "nrmse"],
      "properties": {
        "pair": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2, "maxItems": 2},
        "target": {"type": "string", "minLength": 1},
        "rmse": {"type": "number", "minimum": 0},
        "max_abs": {"type": "number", "minimum": 0},
        "mean_abs": {"type": "number", "minimum": 0},
        "nrmse": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "Metrics": {"type": "array", "items": {"$ref": "#/$defs/Metric"}},
    "RotorAverageMethod": {
      "type": "object",
      "required": ["software", "method", "sample_count", "sampling", "aggregation", "implementation", "nodes_y", "nodes_z", "weights"],
      "properties": {
        "software": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "sampling": {"type": "string"},
        "aggregation": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "nodes_y": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "nodes_z": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "weights": {"type": "array", "items": {"type": "number"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "RotorAverageResult": {
      "type": "object",
      "required": ["case", "software", "method", "sample_count", "aggregation", "rotor_average", "reference_average", "absolute_error", "relative_error"],
      "properties": {
        "case": {"type": "string", "minLength": 1},
        "software": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "aggregation": {"type": "string", "minLength": 1},
        "rotor_average": {"type": "number"},
        "reference_average": {"type": "number"},
        "absolute_error": {"type": "number", "minimum": 0},
        "relative_error": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "RotorAverageCase": {
      "type": "object",
      "required": ["key", "name", "formula", "description", "analytic_area_average", "field", "results"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "analytic_area_average": {"type": ["number", "null"]},
        "field": {
          "type": "object",
          "required": ["axis", "values"],
          "properties": {
            "axis": {"type": "array", "items": {"type": "number"}, "minItems": 1},
            "values": {"type": "array", "items": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 1}, "minItems": 1}
          },
          "additionalProperties": false
        },
        "results": {"type": "array", "items": {"$ref": "#/$defs/RotorAverageResult"}}
      },
      "additionalProperties": false
    },
    "RotorAverageDataset": {
      "type": "object",
      "required": ["coordinates", "reference", "methods", "cases"],
      "properties": {
        "coordinates": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "methods": {"type": "array", "items": {"$ref": "#/$defs/RotorAverageMethod"}, "minItems": 1},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/RotorAverageCase"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "TurbinePerformanceResult": {
      "type": "object",
      "required": ["software", "turbine_model", "inputs", "interpolation", "out_of_range", "implementation", "power_kw", "ct", "max_abs_power_error_kw", "max_abs_ct_error", "max_abs_power_error_in_range_kw", "max_abs_ct_error_in_range"],
      "properties": {
        "software": {"type": "string", "minLength": 1},
        "turbine_model": {"type": "string", "minLength": 1},
        "inputs": {"type": "string", "minLength": 1},
        "interpolation": {"type": "string", "minLength": 1},
        "out_of_range": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "power_kw": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "ct": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "max_abs_power_error_kw": {"type": "number", "minimum": 0},
        "max_abs_ct_error": {"type": "number", "minimum": 0},
        "max_abs_power_error_in_range_kw": {"type": "number", "minimum": 0},
        "max_abs_ct_error_in_range": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "TurbinePerformanceDataset": {
      "type": "object",
      "required": ["turbine", "setup", "execution", "reference", "wind_speeds", "reference_curves", "results"],
      "properties": {
        "turbine": {
          "type": "object",
          "required": ["name", "rotor_diameter", "hub_height", "air_density", "cut_in", "cut_out", "rated_power_kw", "curve"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "rotor_diameter": {"type": "number", "exclusiveMinimum": 0},
            "hub_height": {"type": "number", "exclusiveMinimum": 0},
            "air_density": {"type": "number", "exclusiveMinimum": 0},
            "cut_in": {"type": "number", "minimum": 0},
            "cut_out": {"type": "number", "exclusiveMinimum": 0},
            "rated_power_kw": {"type": "number", "exclusiveMinimum": 0},
            "curve": {
              "type": "object",
              "required": ["wind_speeds", "power_kw", "ct"],
              "properties": {
                "wind_speeds": {"type": "array", "items": {"type": "number"}, "minItems": 1},
                "power_kw": {"type": "array", "items": {"type": "number"}, "minItems": 1},
                "ct": {"type": "array", "items": {"type": "number"}, "minItems": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "setup": {"type": "string", "minLength": 1},
        "execution": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "wind_speeds": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "reference_curves": {
          "type": "object",
          "required": ["power_kw", "ct"],
          "properties": {
            "power_kw": {"type": "array", "items": {"type": "number"}, "minItems": 1},
            "ct": {"type": "array", "items": {"type": "number"}, "minItems": 1}
          },
          "additionalProperties": false
        },
        "results": {"type": "array", "items": {"$ref": "#/$defs/TurbinePerformanceResult"}, "minItems": 1}
      },
      "additionalProperties": false
    }
  }
}